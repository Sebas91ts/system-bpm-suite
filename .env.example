# Flutter production template
# Use this file as a guide for the real .env in each environment.

API_BASE_URL=https://api.your-domain.com/api

FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
FIREBASE_APP_ID=replace-with-app-id
FIREBASE_API_KEY=replace-with-api-key
